NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" —
# protects /api/cron, /api/cron-fines, and /api/attendance/rollup.
# Set the same value in Vercel → Settings → Environment Variables.
CRON_SECRET=change-me-to-something-random
